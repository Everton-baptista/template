# Configurações da Aplicação
ENV=development
DEBUG=true
PROJECT_NAME="Agno Multi-Agent System"

# API Keys para LLMs (Insira as que deseja utilizar)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIzaSy...
GROQ_API_KEY=gsk_...

# Modelo padrão do Agno
DEFAULT_MODEL_PROVIDER=openai
DEFAULT_MODEL_ID=gpt-4o-mini

# API Keys para Ferramentas de Busca & Research
EXA_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=

# API Keys para Scraping & Extração Web
FIRECRAWL_API_KEY=
SPIDER_API_KEY=
BROWSERBASE_API_KEY=

# API Keys para DevOps & VCS
GITHUB_TOKEN=
E2B_API_KEY=

# API Keys para Comunicação & Mensageria
SLACK_BOT_TOKEN=
DISCORD_BOT_TOKEN=
RESEND_API_KEY=
JIRA_API_KEY=
NOTION_API_KEY=

# Banco de Dados & RAG
DATABASE_URL=postgresql://agno:agno_secret@localhost:5432/agno_db
VECTOR_DB_URL=postgresql://agno:agno_secret@localhost:5432/agno_db

# Configurações de Segurança / Cors
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]
